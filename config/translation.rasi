configuration {
    font: "JetBrainsMono Nerd Font 15";
    show-icons: false;
    disable-history: true;
}

* {
    background: #282a36;
    foreground: #f8f8f2;

    purple: #bd93f9;
    pink: #ff79c6;
    cyan: #8be9fd;
    green: #50fa7b;
    yellow: #f1fa8c;
    blue: #6272a4;
}

window {
    width: 700px;

    border: 1px;
    border-color: #6272a4;
    border-radius: 10px;

    padding: 18px;

    background-color: #282a36;
}

mainbox {
    orientation: vertical;

    spacing: 12px;

    children: [
        "inputbar",
        "message",
        "listview"
    ];

    background-color: #282a36;
}

inputbar {
    background-color: #282a36;

    children: [
        "prompt",
        "entry"
    ];
}

prompt {
    text-color: #bd93f9;
    background-color: #282a36;

    padding: 5px 12px 5px 0px;
}

entry {
    text-color: #f8f8f2;
    background-color: #282a36;
}

message {
    background-color: #282a36;

    padding: 8px 0px;

    children: [
        "textbox"
    ];
}

textbox {
    text-color: #8be9fd;
    background-color: #282a36;
}

listview {
    background-color: #282a36;

    scrollbar: false;
    spacing: 0px;

    lines: 1;
}

element {
    background-color: #282a36;

    padding: 14px;

    children: [
        "element-text"
    ];
}

element selected {
    background-color: #282a36;
}

element-text {
    text-color: #f8f8f2;
    background-color: #282a36;

    vertical-align: 0.5;
}

element-text selected {
    text-color: #f8f8f2;
    background-color: #282a36;
}
